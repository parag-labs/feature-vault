      "x": 300,
      "y": 204,
      "width": 360,
      "height": 32,
      "text": "as-of join returns v3 (newest value with ts <= T)",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#2f9e44",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-22",
      "x": 300,
      "y": 232,
      "width": 360,
      "height": 32,
      "text": "v4 is AFTER T, so it is never returned",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#c92a2a",
      "textAlign": "left",
      "verticalAlign": "top"
    },
